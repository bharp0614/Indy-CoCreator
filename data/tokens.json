{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "PlumbPro Design System",
  "version": "1.0.0",
  "description": "Design tokens for a plumbing services web app (booking, dispatch, invoicing, customer portal).",

  "color": {
    "primary": {
      "50":  { "value": "#EFF6FC", "description": "Lightest tint — page backgrounds, selected-row highlight" },
      "100": { "value": "#DBEAF7", "description": "Info banners, hover backgrounds" },
      "200": { "value": "#B8D4EF", "description": "Borders on light surfaces" },
      "300": { "value": "#8AB8E3", "description": "Disabled primary elements" },
      "400": { "value": "#5497D3", "description": "Icons, secondary accents" },
      "500": { "value": "#1D6FB8", "description": "Base brand blue — links, secondary buttons. 5.23:1 on white" },
      "600": { "value": "#125A96", "description": "Default button/nav background. 7.17:1 with white text" },
      "700": { "value": "#0E4676", "description": "Button hover/active. 9.74:1 with white text" },
      "800": { "value": "#0B3557", "description": "Header/footer dark surfaces" },
      "900": { "value": "#082741", "description": "Darkest — text on light-blue surfaces" }
    },
    "accent": {
      "description": "Emergency / urgent CTA color (e.g. 'Call Now', '24/7 Emergency')",
      "50":  { "value": "#FFF3ED" },
      "100": { "value": "#FFE1D1" },
      "200": { "value": "#FFC0A3" },
      "300": { "value": "#FF9A6E" },
      "400": { "value": "#F2712F" },
      "500": { "value": "#EA580C", "description": "Use only for large text/icons (3.56:1) — not small body text on white" },
      "600": { "value": "#C2410C", "description": "Default emergency CTA background. 5.18:1 with white text" },
      "700": { "value": "#9A3412", "description": "Emergency CTA hover/active. 7.31:1 with white text" },
      "800": { "value": "#7C2D12" },
      "900": { "value": "#5B2110" }
    },
    "neutral": {
      "0":   { "value": "#FFFFFF" },
      "50":  { "value": "#F9FAFB", "description": "App background" },
      "100": { "value": "#F3F4F6", "description": "Card/section alt background" },
      "200": { "value": "#E5E7EB", "description": "Borders, dividers" },
      "300": { "value": "#D1D5DB", "description": "Input borders" },
      "400": { "value": "#9CA3AF", "description": "Placeholder text, disabled text" },
      "500": { "value": "#6B7280", "description": "Secondary/muted text. 4.83:1 on white" },
      "600": { "value": "#4B5563", "description": "Body text (alt)" },
      "700": { "value": "#374151", "description": "Primary body text. 10.31:1 on white" },
      "800": { "value": "#1F2937", "description": "Headings" },
      "900": { "value": "#111827", "description": "Highest-contrast text. 17.74:1 on white" }
    },
    "semantic": {
      "success": {
        "50":  { "value": "#F0FDF4" },
        "500": { "value": "#22C55E", "description": "Icons, badges" },
        "700": { "value": "#15803D", "description": "Text on success-50. 4.79:1" }
      },
      "warning": {
        "50":  { "value": "#FFFBEB" },
        "500": { "value": "#F59E0B", "description": "Icons, badges" },
        "800": { "value": "#92400E", "description": "Text on warning-50. 6.84:1" }
      },
      "error": {
        "50":  { "value": "#FEF2F2" },
        "500": { "value": "#EF4444", "description": "Icons, badges" },
        "700": { "value": "#B91C1C", "description": "Text on error-50. 5.91:1" }
      },
      "info": {
        "50":  { "value": "#EFF6FC" },
        "500": { "value": "#3B82F6" },
        "700": { "value": "#0E4676" }
      }
    }
  },

  "typography": {
    "fontFamily": {
      "sans":  { "value": "'Inter', -apple-system, 'Segoe UI', Roboto, sans-serif", "description": "UI text, body" },
      "display": { "value": "'Lexend', 'Inter', sans-serif", "description": "Headings — slightly more geometric, confident" },
      "mono":  { "value": "'JetBrains Mono', 'SFMono-Regular', monospace", "description": "Invoice numbers, job IDs" }
    },
    "fontSize": {
      "xs":   { "value": "0.75rem",  "px": 12, "lineHeight": "1rem" },
      "sm":   { "value": "0.875rem", "px": 14, "lineHeight": "1.25rem" },
      "base": { "value": "1rem",     "px": 16, "lineHeight": "1.5rem" },
      "lg":   { "value": "1.125rem", "px": 18, "lineHeight": "1.75rem" },
      "xl":   { "value": "1.25rem",  "px": 20, "lineHeight": "1.75rem" },
      "2xl":  { "value": "1.5rem",   "px": 24, "lineHeight": "2rem" },
      "3xl":  { "value": "1.875rem", "px": 30, "lineHeight": "2.25rem" },
      "4xl":  { "value": "2.25rem",  "px": 36, "lineHeight": "2.5rem" },
      "5xl":  { "value": "3rem",     "px": 48, "lineHeight": "1.1" }
    },
    "fontWeight": {
      "regular":  { "value": "400" },
      "medium":   { "value": "500" },
      "semibold": { "value": "600" },
      "bold":     { "value": "700" }
    },
    "letterSpacing": {
      "tight": { "value": "-0.02em", "description": "Large headings" },
      "normal": { "value": "0" },
      "wide": { "value": "0.02em", "description": "Uppercase labels, badges" }
    }
  },

  "spacing": {
    "description": "4px base unit",
    "0":  { "value": "0px" },
    "1":  { "value": "0.25rem", "px": 4 },
    "2":  { "value": "0.5rem",  "px": 8 },
    "3":  { "value": "0.75rem", "px": 12 },
    "4":  { "value": "1rem",    "px": 16 },
    "5":  { "value": "1.25rem", "px": 20 },
    "6":  { "value": "1.5rem",  "px": 24 },
    "8":  { "value": "2rem",    "px": 32 },
    "10": { "value": "2.5rem",  "px": 40 },
    "12": { "value": "3rem",    "px": 48 },
    "16": { "value": "4rem",    "px": 64 },
    "20": { "value": "5rem",    "px": 80 },
    "24": { "value": "6rem",    "px": 96 }
  },

  "radius": {
    "none": { "value": "0px" },
    "sm":   { "value": "0.25rem", "px": 4,  "description": "Badges, checkboxes" },
    "md":   { "value": "0.5rem",  "px": 8,  "description": "Inputs, buttons" },
    "lg":   { "value": "0.75rem", "px": 12, "description": "Cards" },
    "xl":   { "value": "1rem",    "px": 16, "description": "Modals, large panels" },
    "2xl":  { "value": "1.5rem",  "px": 24, "description": "Hero panels, marketing cards" },
    "full": { "value": "9999px", "description": "Pills, avatars, status dots" }
  },

  "shadow": {
    "xs": { "value": "0 1px 2px 0 rgb(17 24 39 / 0.05)" },
    "sm": { "value": "0 1px 3px 0 rgb(17 24 39 / 0.08), 0 1px 2px -1px rgb(17 24 39 / 0.06)" },
    "md": { "value": "0 4px 6px -1px rgb(17 24 39 / 0.08), 0 2px 4px -2px rgb(17 24 39 / 0.06)" },
    "lg": { "value": "0 10px 15px -3px rgb(17 24 39 / 0.08), 0 4px 6px -4px rgb(17 24 39 / 0.05)" },
    "xl": { "value": "0 20px 25px -5px rgb(17 24 39 / 0.10), 0 8px 10px -6px rgb(17 24 39 / 0.05)" },
    "focus-primary": { "value": "0 0 0 3px rgb(29 111 184 / 0.35)", "description": "Focus ring for primary elements" },
    "focus-accent":  { "value": "0 0 0 3px rgb(194 65 12 / 0.35)", "description": "Focus ring for emergency/accent elements" },
    "focus-error":   { "value": "0 0 0 3px rgb(239 68 68 / 0.35)", "description": "Focus ring on invalid fields" }
  },

  "breakpoint": {
    "sm":  { "value": "640px" },
    "md":  { "value": "768px" },
    "lg":  { "value": "1024px" },
    "xl":  { "value": "1280px" },
    "2xl": { "value": "1536px" }
  },

  "motion": {
    "duration": {
      "fast":   { "value": "150ms" },
      "normal": { "value": "250ms" },
      "slow":   { "value": "400ms" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "decelerate": { "value": "cubic-bezier(0, 0, 0.2, 1)" },
      "accelerate": { "value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },

  "zIndex": {
    "dropdown": { "value": 1000 },
    "sticky":   { "value": 1100 },
    "overlay":  { "value": 1200 },
    "modal":    { "value": 1300 },
    "popover":  { "value": 1400 },
    "toast":    { "value": 1500 },
    "tooltip":  { "value": 1600 }
  }
}
